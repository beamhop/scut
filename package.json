{
  "name": "scut",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:ui": "bun run --cwd packages/ui build",
    "build:image": "docker build -f image/Dockerfile -t ghcr.io/beamhop/scut-agent:dev .",
    "build:app": "./scripts/build-app.sh",
    "test": "bun test tests/e2e.test.ts tests/ui.test.ts --timeout 600000",
    "typecheck": "tsc --noEmit -p .",
    "test:ui": "bun test tests/ui.test.ts --timeout 300000"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "bun-plugin-tailwind": "^0.1.2",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/hashes": "^2.4.0",
    "@scut/agent": "workspace:*",
    "@scut/agentd": "workspace:*",
    "@scut/app": "workspace:*",
    "@scut/beam": "workspace:*",
    "@scut/channels": "workspace:*",
    "@scut/drivers": "workspace:*",
    "@scut/protocol": "workspace:*",
    "@scut/ui": "workspace:*",
    "nostr-tools": "^2.26.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "version": "0.28.0",
  "optionalDependencies": {
    "smolmachines": "1.32.4"
  }
}
