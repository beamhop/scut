{
  "name": "scut",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:ui": "bun run --cwd packages/ui build",
    "build:image": "docker build -f image/Dockerfile -t ghcr.io/beamhop/scut-agent:dev .",
    "build:app": "bun build apps/app/src/main.ts --compile --outfile dist/scut",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/hashes": "^2.4.0",
    "nostr-tools": "^2.26.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "@scut/protocol": "workspace:*",
    "@scut/beam": "workspace:*",
    "@scut/agentd": "workspace:*",
    "@scut/agent": "workspace:*",
    "@scut/channels": "workspace:*",
    "@scut/drivers": "workspace:*",
    "@scut/ui": "workspace:*",
    "@scut/app": "workspace:*"
  }
}